{
  "name": "mettaloid",
  "productName": "Mettaloid",
  "version": "0.1.0",
  "description": "Instant-replay game clipper built on OBS Studio, with an editor and size-targeted compressor.",
  "main": "electron/main.js",
  "author": "Mettaloid",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "fetch-obs": "node scripts/fetch-obs.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "obs-websocket-js": "5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.mettaloid.app",
    "productName": "Mettaloid",
    "copyright": "Mettaloid",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "findframe-engine/dist/findframe-engine",
        "to": "findframe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/obs",
        "to": "obs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Mettaloid-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mettaloid",
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "mettaloid",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "ffmpeg-static@5.2.0": true,
    "esbuild@0.21.5": true
  }
}
